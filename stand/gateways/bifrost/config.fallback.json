{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enable_logging": false,
    "enforce_auth_on_inference": true
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/state/config.db"
    }
  },
  "logs_store": {
    "enabled": false
  },
  "framework": {
    "pricing": {
      "pricing_url": "file:///app/offline/pricing.json",
      "model_parameters_url": "file:///app/offline/model-parameters.json",
      "pricing_sync_interval": 86400,
      "mcp_library_sync_interval": 0
    }
  },
  "providers": {
    "mocka": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "http://127.0.0.1:9000"
      },
      "keys": [
        {
          "name": "ka",
          "value": "sk-upstream-SENTINELUP7f3a2b",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    },
    "mockb": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "http://127.0.0.1:9010"
      },
      "keys": [
        {
          "name": "kb",
          "value": "sk-upstream-SENTINELUP7f3a2b",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "route-mocka-fallback-mockb",
        "name": "mocka with fallback to mockb",
        "cel_expression": "true",
        "targets": [
          {
            "provider": "mocka",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "mockb/"
        ]
      }
    ],
    "auth_config": {
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "is_enabled": true,
      "disable_auth_on_inference": true
    },
    "virtual_keys": [
      {
        "id": "vk-bench",
        "name": "bench",
        "value": "env.BENCH_VK",
        "is_active": true,
        "allow_all_providers": true
      }
    ]
  }
}
