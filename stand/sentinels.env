# Маркеры для поиска утечек. Значения специально нетипичные: grep по ним
# не даст ложных срабатываний, в отличие от "dummy" или "sk-test".
UPSTREAM_KEY=sk-upstream-SENTINELUP7f3a2b
MASTER_KEY=sk-client-SENTINELCL9d4e1c
# Виртуальный ключ клиента в профиле keys. Префикс sk-bf- требует Bifrost,
# LiteLLM принимает любой sk-*. new-api генерирует токены сам.
BENCH_VK=sk-bf-SENTINELVK5e8a1f
